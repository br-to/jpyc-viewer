# バックエンドウォレットの秘密鍵
#
# 用途:
# - EIP-3009のtransferWithAuthorizationを実行するために使用
# - バックエンド（リレイヤー）がガス代を負担してトランザクションを送信
#
# 設定方法:
# 1. テスト用の新しいウォレットを作成
# 2. 秘密鍵をコピー（0xで始まる64文字の16進数）
# 3. .env.localファイルにペースト
# 4. テストネット（Sepolia）のETHを少量取得してガス代に充てる
#
# ⚠️ 警告:
# - 絶対にメインウォレットの秘密鍵を使わないこと
# - .env.localはGitにコミットされません（.gitignoreに含まれています）
# - 本番環境では、より安全な秘密鍵管理方法を検討してください
#   （例: AWS Secrets Manager, GCP Secret Manager, Vercel Environment Variables）
#
BACKEND_PRIVATE_KEY=0x...your_private_key_here...

# 商店のウォレットアドレス（JPYCを受け取るアドレス）
# 現在はroute.tsでハードコードされていますが、環境変数化を推奨
# MERCHANT_WALLET_ADDRESS=0x04655AC316BFB463D8C3e4dFcFbce23642AA753d

RELAYER_PRIVATE_KEY="0x...your_private_key_here..."
