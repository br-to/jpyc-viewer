// Prisma Schema for JPYC Subscription Payment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// サブスクリプション本体
// ============================================

model Subscription {
  id              String              @id @default(uuid())
  customerAddress String              // 顧客のウォレットアドレス
  merchantAddress String              // 加盟店のウォレットアドレス
  planName        String              // プラン名 (例: "ベーシックプラン")
  amount          Decimal             // 月額料金 (JPYC単位)
  totalAmount     Decimal             // 合計金額 (月額 × 契約月数)
  billingCycle    BillingCycle        // 課金サイクル
  status          SubscriptionStatus  // サブスクの状態
  startDate       DateTime            // 開始日
  nextBillingDate DateTime?           // 次回請求日
  endDate         DateTime?           // 終了日 (キャンセル時)
  totalMonths     Int                 // 契約月数
  currentCycle    Int                 @default(0) // 現在の請求サイクル (0から開始)

  // EIP-2612 Permit署名（1つだけ）
  permitDeadline BigInt              // Permitの有効期限
  permitV        Int                 // ECDSA署名のv
  permitR        String              // ECDSA署名のr
  permitS        String              // ECDSA署名のs
  permitExecuted Boolean             @default(false) // permit()実行済みフラグ

  // リレーション
  payments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerAddress])
  @@index([status, nextBillingDate]) // 実行すべき支払いの検索用
}

enum BillingCycle {
  monthly // 月次
  quarterly // 四半期
  yearly // 年次
}

enum SubscriptionStatus {
  active // 有効
  paused // 一時停止
  cancelled // キャンセル済み
  expired // 期限切れ
  failed // 決済失敗
}

// ============================================
// 各月の支払い
// ============================================

model SubscriptionPayment {
  id             String                    @id @default(uuid())
  subscriptionId String // 親のサブスクリプションID
  subscription   Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // 支払い情報
  amount        Decimal                   // 支払い額 (JPYC単位)
  cycleNumber   Int                       // 何回目の支払いか (1, 2, 3, ...)
  scheduledDate DateTime                  // 実行予定日

  // 実行状態
  status       SubscriptionPaymentStatus @default(pending)
  txHash       String? // トランザクションハッシュ
  executedAt   DateTime? // 実行日時
  errorMessage String? // エラーメッセージ
  retryCount   Int                       @default(0) // リトライ回数

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([status, scheduledDate]) // 実行待ちの支払いを検索
}

enum SubscriptionPaymentStatus {
  pending // 実行待ち
  processing // 実行中
  completed // 完了
  failed // 失敗
  cancelled // キャンセル
}

// ============================================
// サブスクプランのマスタデータ（オプション）
// ============================================

model SubscriptionPlan {
  id          String  @id @default(uuid())
  name        String  @unique
  description String
  amount      Decimal // 月額料金
  features    Json // プランの特徴 (JSON配列)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
